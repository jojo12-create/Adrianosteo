# ==========================================================================
# Configuration Apache / LiteSpeed (hébergement actuel : LiteSpeed)
# ==========================================================================

# Page 404 personnalisée
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + domaine sans www (décommenter une fois le certificat en place)
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://osteovillefontaine.fr%{REQUEST_URI} [L,R=301]

  # Redirections 301 des anciennes pages (conservent le référencement acquis)
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteRule ^nourrissons\.html$ /osteopathie/bebe-enfant/ [L,R=301]
  RewriteRule ^nourissons\.html$ /osteopathie/bebe-enfant/ [L,R=301]
  RewriteRule ^enfants\.html$ /osteopathie/bebe-enfant/ [L,R=301]
  RewriteRule ^adultes\.html$ /osteopathie/mal-de-dos/ [L,R=301]
  RewriteRule ^femmes-enceintes\.html$ /osteopathie/femme-enceinte/ [L,R=301]
  RewriteRule ^seniors\.html$ /osteopathie/seniors/ [L,R=301]
  RewriteRule ^sportifs\.html$ /osteopathie/sportifs/ [L,R=301]
  RewriteRule ^mentionslegales\.html$ /mentions-legales/ [L,R=301]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Cache : fichiers versionnés par Vite (assets/) = 1 an ; images = 30 jours ; HTML = revalidé
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

AddType image/avif .avif
AddType application/manifest+json .webmanifest
